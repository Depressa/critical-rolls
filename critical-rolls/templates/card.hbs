<div class="critical-rolls-card {{kind}}">
  <header class="cr-header">
    <span class="cr-natural">{{natural}}</span>
    <h3 class="cr-title">{{title}}</h3>
  </header>
  <dl class="cr-rows">
    {{#each rows}}
    <dt>{{label}}</dt>
    <dd>{{value}}</dd>
    {{/each}}
    <dt>{{labels.dice}}</dt>
    <dd>
      {{#each dice}}<span class="cr-die {{#if kept}}kept{{else}}discarded{{/if}}">{{value}}</span>{{/each}}
      {{#if mode}}<em>{{mode}}</em>{{/if}}
    </dd>
    <dt>{{labels.total}}</dt>
    <dd>{{total}}</dd>
  </dl>
  {{#if missing}}
  <p class="cr-missing">{{labels.missing}}</p>
  {{/if}}
  {{#if result}}
  <section class="cr-result">
    {{#if result.line}}<p class="cr-table">{{result.line}}</p>{{/if}}
    {{#if result.single}}
    <p class="cr-effect">{{{result.html}}}</p>
    {{else}}
    <ol class="cr-variants">
      {{#each result.variants}}
      <li class="{{#if chosen}}chosen{{/if}} {{#if dimmed}}dimmed{{/if}}">{{{html}}}</li>
      {{/each}}
    </ol>
    {{/if}}
    {{#if statusText}}<p class="cr-status">{{statusText}}</p>{{/if}}
    {{#if itemLine}}<p class="cr-item">{{{itemLine}}}</p>{{/if}}
    {{#if jobs.length}}
    <ul class="cr-jobs">
      {{#each jobs}}
      <li class="{{#if applied}}applied{{/if}}">
        <span class="cr-job-text">{{text}}</span>
        {{#if note}}<em class="cr-job-note">{{note}}</em>{{/if}}
        {{#if canApply}}<button type="button" data-cr-action="applyJob" data-cr-value="{{index}}">{{buttonLabel}}</button>{{/if}}
      </li>
      {{/each}}
    </ul>
    {{/if}}
    {{#if buttons.length}}
    <div class="cr-actions">
      {{#each buttons}}<button type="button" data-cr-action="{{action}}" data-cr-value="{{value}}">{{label}}</button>{{/each}}
    </div>
    {{/if}}
  </section>
  {{/if}}
</div>
